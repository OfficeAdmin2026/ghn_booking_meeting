NODE_ENV=production
PORT=5000

# === DATABASE ===
# Option 1: single connection string (Supabase / Render / Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: individual params (local dev only)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ghn_meeting_room_booking
# DB_USER=postgres
# DB_PASSWORD=

# === JWT ===
JWT_SECRET=replace_with_random_64_char_string
JWT_EXPIRES_IN=7d

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.netlify.app
# Nơi redirect sau khi SSO xong; nếu bỏ trống sẽ lấy phần tử đầu của ALLOWED_ORIGINS
FRONTEND_URL=

# === SSO (GHN SSO v2 / OpenID Connect) ===
# Thiếu BẤT KỲ biến nào trong 5 biến dưới đây (hoặc SSO_ENABLED khác đúng chuỗi "true") sẽ
# khiến isEnabled() trả false — production sẽ TỪ CHỐI khởi động nếu vậy (xem server.js),
# thay vì âm thầm mở lại đăng nhập chỉ-bằng-MSNV không mật khẩu.
SSO_ENABLED=true
SSO_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# Không đặt thì dùng chung JWT_SECRET để ký `state` — nên tách riêng.
SSO_STATE_SECRET=replace_with_another_random_64_char_string
